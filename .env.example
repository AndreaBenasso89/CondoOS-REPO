# Copy to .env for local dev. NEVER commit a real .env. EU residency assumed at deploy time.
CONDOOS_ENVIRONMENT=dev

# Datastores (match infra/docker/docker-compose.yml)
CONDOOS_DATABASE_URL=postgresql+psycopg://condoos:condoos@localhost:5432/condoos
CONDOOS_AUDIT_DATABASE_URL=postgresql+psycopg://condoos:condoos@localhost:5432/condoos_audit
CONDOOS_REDIS_URL=redis://localhost:6379/0
CONDOOS_QDRANT_URL=http://localhost:6333
CONDOOS_OBJECT_STORE_ENDPOINT=http://localhost:9000
CONDOOS_OBJECT_STORE_BUCKET=condoos-documents
CONDOOS_NATS_URL=nats://localhost:4222

# LLM (leave key empty to run the offline stub path)
CONDOOS_ANTHROPIC_API_KEY=
CONDOOS_LLM_PRIMARY_MODEL=claude-opus-4-8
CONDOOS_LLM_FAST_MODEL=claude-haiku-4-5-20251001

# Governance / safety
CONDOOS_DEFAULT_AUTONOMY_MODE=supervised
CONDOOS_PER_TASK_TOKEN_BUDGET=200000
CONDOOS_PER_TENANT_DAILY_COST_EUR=5.0

# Security — replace with a KMS-managed key in staging/prod
CONDOOS_VERDICT_SIGNING_KEY=dev-insecure-signing-key-change-me
