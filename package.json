{
  "name": "condominioos",
  "version": "0.1.0",
  "private": true,
  "description": "CondominioOS monorepo — frontends and shared TS packages (backend lives in /services).",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm --filter \"./apps/*\" build",
    "lint": "pnpm --filter \"./apps/*\" lint"
  },
  "packageManager": "pnpm@9.0.0",
  "workspaces": ["apps/*", "packages/ui", "packages/sdk-ts"]
}
